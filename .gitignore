# dependencies
node_modules/
.pnpm-store/

# builds
dist/
.next/
out/
.turbo/
# TypeScript incremental cache — never commit it: a stale one makes tsc skip
# emitting files that are already "up to date", producing a partial dist.
*.tsbuildinfo

# local media storage (STORAGE_BACKEND=local)
.media/

# environment
.env
.env.local
.env.*.local

# python
__pycache__/
*.pyc
.venv/
.pytest_cache/
.ruff_cache/
celerybeat-schedule*

# prisma
packages/db/generated/

# misc
.DS_Store
*.log
coverage/
# pytest-cov's data file (a file, so the bare `coverage/` rule above misses it)
.coverage
.idea/
.vscode/*
!.vscode/extensions.json

# setuptools build metadata, regenerated on every install
*.egg-info/
