# Never ship secrets into an image
.env
.env.*
!.env.example

# Installed/generated artifacts — rebuilt inside the image
node_modules
**/node_modules
**/dist
**/.next
**/.turbo
**/generated
.venv
**/.venv
**/__pycache__
**/*.pyc
**/.pytest_cache
**/.ruff_cache
# setuptools writes this next to the package in a src layout. A copy from the
# host is stale by definition and has no business in the image.
**/*.egg-info

# Local-only state
.media
dump.rdb
# Must be **/ — Docker's * does not cross directory separators, so a bare
# *.tsbuildinfo would leave packages/*/tsconfig.tsbuildinfo in the context and
# make tsc skip emitting files it thinks are already built.
**/*.tsbuildinfo

# Not needed at runtime
.git
.github
.claude
docs
**/*.md
!apps/engine/README.md
**/*.spec.ts
**/tests
