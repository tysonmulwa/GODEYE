# ============================================================
# GODEYE environment — copy to .env and fill in values
# ============================================================

# ---------- Core ----------
NODE_ENV=development
API_PORT=4000
WEB_URL=http://localhost:3000
API_URL=http://localhost:4000
ENGINE_URL=http://localhost:8000

# ---------- Database (matches infra/docker/docker-compose.yml) ----------
DATABASE_URL=postgresql://godeye:godeye_dev_password@localhost:5432/godeye?schema=public

# ---------- Redis ----------
REDIS_URL=redis://localhost:6379/0

# ---------- Object storage (MinIO locally, S3 in production) ----------
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=godeye
S3_SECRET_KEY=godeye_dev_secret
S3_BUCKET=godeye-media
S3_REGION=us-east-1

# ---------- Security ----------
# Every value below MUST be replaced. They are deliberately NOT valid: the
# validators in apps/api/src/common/secrets.ts and apps/engine/.../config.py
# refuse a placeholder, a published default, or a format-valid key with no
# entropy, and the service refuses to boot rather than run on one.
#
# Generate each one separately:   openssl rand -hex 32
#
# Separately matters. Reusing one value for two of these is refused at boot.
JWT_ACCESS_SECRET=REPLACE_ME__run_openssl_rand_hex_32
JWT_REFRESH_SECRET=REPLACE_ME__run_openssl_rand_hex_32
# Signs the OAuth `state` parameter and nothing else. `state` travels through
# Meta, TikTok, LinkedIn and Reddit by design and lands in their logs, so it
# must never be signed with the session key (finding C-1).
OAUTH_STATE_SECRET=REPLACE_ME__run_openssl_rand_hex_32
# AES-256-GCM key for stored platform tokens and TOTP secrets. 64 hex chars.
# This file used to ship 64 zeros here, which was format-valid: every credential
# in a workspace started from this file was encrypted with a key in the repo.
TOKEN_ENCRYPTION_KEY=REPLACE_ME__run_openssl_rand_hex_32
# Only during a key rotation. Comma-separated, the keys still needed to READ
# existing rows. See docs/security/KEY-MANAGEMENT.md.
TOKEN_ENCRYPTION_KEY_PREVIOUS=
# Shared secret between the NestJS API and the Python engine (internal HTTP calls)
ENGINE_INTERNAL_SECRET=REPLACE_ME__run_openssl_rand_hex_32
# Seeds the PUBLIC IndexNow key served from the customer's own website root.
# Must differ from TOKEN_ENCRYPTION_KEY (finding S-6b).
INDEXNOW_KEY_SECRET=REPLACE_ME__run_openssl_rand_hex_32
# Local development only. With NODE_ENV=development this permits the documented
# dev defaults. It has no effect in production, where they are always refused.
ALLOW_INSECURE_DEV_DEFAULTS=false

# ---------- AI providers ----------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
# Optional text fallback + IMAGE generation provider (Anthropic can't make images).
# Set this to enable AI image generation via OpenAI gpt-image-1.
OPENAI_API_KEY=
IMAGE_PROVIDER=openai
OPENAI_IMAGE_MODEL=gpt-image-1
# Alternative image provider: Google Imagen (set IMAGE_PROVIDER=google)
# GOOGLE_API_KEY powers both Gemini text generation and Imagen images.
# Get one at https://aistudio.google.com/apikey (needs free-tier quota or billing).
GOOGLE_API_KEY=
GOOGLE_IMAGE_MODEL=imagen-3.0-generate-002

# ---------- Video generation ----------
# Voiceovers use OpenAI TTS (needs OPENAI_API_KEY above)
OPENAI_TTS_MODEL=tts-1
# ffmpeg is required for video assembly. Leave blank if ffmpeg is on PATH;
# otherwise point at the executable, e.g. C:\tools\ffmpeg\bin\ffmpeg.exe
FFMPEG_PATH=

# ---------- Platform credentials (fill in the ones you use) ----------
# Telegram: create a bot with @BotFather -> token. Users paste their own bot
# token + channel when connecting, so nothing is required here globally.

# Discord: https://discord.com/developers/applications -> Bot -> token.
# Users paste their own bot token + channel id when connecting.

# Reddit: https://www.reddit.com/prefs/apps -> create a "web app"
# Set its redirect uri to REDDIT_REDIRECT_URI below (exact match required).
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=godeye/0.1 by <your_reddit_username>
REDDIT_REDIRECT_URI=http://localhost:4000/connections/reddit/callback

# X (Twitter): developer.x.com -> project + app with Read and Write -> Keys.
# These are this application's consumer keys, the same for every workspace,
# exactly like the Meta and TikTok app credentials. They used to be collected
# from each customer, which meant every one of them needed their own X
# developer account and approved app.
#
# Customers now press Connect and authorize on X, exactly as they do for
# Reddit and LinkedIn. X still runs OAuth 1.0a for posting, so these are the
# app's Consumer Keys (API Key / API Key Secret) — NOT the OAuth 2.0 Client ID
# and Client Secret, which look similar on the same page and will not sign a
# request. The app needs Read and Write permission.
#
# X_REDIRECT_URI must also be listed verbatim under the app's
# "Callback URI / Redirect URL". X compares the string exactly, so a trailing
# slash counts as a different URL.
X_API_KEY=
X_API_SECRET=
X_REDIRECT_URI=https://api.godeyeautomation.com/connections/x/callback

# LinkedIn: https://developer.linkedin.com -> create app -> add "Share on LinkedIn"
# and "Sign In with LinkedIn using OpenID Connect" products
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:4000/connections/linkedin/callback

# Instagram API with Instagram Login — lets a creator connect an Instagram
# Business/Creator account with NO linked Facebook Page. In your Meta app add
# the "Instagram" product (Instagram API setup with Instagram login) and use the
# Instagram app ID/secret from there — these are NOT the same as META_APP_*.
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_REDIRECT_URI=http://localhost:4000/connections/instagram/callback

# Meta (Facebook + Instagram + Threads): https://developers.facebook.com
# App with permissions: pages_manage_posts, pages_read_engagement,
# instagram_basic, instagram_content_publish, business_management
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=http://localhost:4000/connections/meta/callback
META_WEBHOOK_VERIFY_TOKEN=REPLACE_ME__run_openssl_rand_hex_32

# Paystack — the only payment provider: https://dashboard.paystack.com/#/settings/developers
# Without these, billing still meters usage and the 24-hour trial still expires;
# the upgrade buttons simply hide rather than opening a checkout that cannot start.
#
# The secret key is also the webhook signing key, so it must never reach the
# browser. Point the Paystack webhook at https://<api>/webhooks/paystack.
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
# Paystack *plan* codes (PLN_...), one per tier, created under Products -> Plans
# with a monthly interval. These are what make a charge recur — without them a
# subscription would be a single payment that silently never renews, and
# checkout refuses rather than take money on that promise.
PAYSTACK_PLAN_PRO=
PAYSTACK_PLAN_PREMIUM=
PAYSTACK_PLAN_VIP=
# Which ways to pay the billing page offers. Paystack can only charge a card
# again automatically, so a card subscribes and renews in USD, while Apple Pay
# (USD) and M-Pesa (KES, the only currency it settles in) each buy one month.
# Narrowing this list never widens what Paystack allows: the account still has
# to have the channel enabled and the currency approved.
PAYSTACK_METHODS=card,apple_pay,mpesa

# TikTok Content Posting API: https://developers.tiktok.com -> your app.
# Needs the video.publish scope (direct post). No domain verification required:
# GODEYE uploads the video bytes (FILE_UPLOAD) rather than having TikTok pull a
# URL, which would need the media host verified — impossible on S3/Supabase.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=http://localhost:4000/connections/tiktok/callback
# TikTok URL-property verification. Comma-separated list of the tokens TikTok
# issues (the part after "tiktok-developers-site-verification=") — it mints a
# new one per URL property. The API serves each at /tiktok<token>.txt and at
# /connections/tiktok/callback/tiktok<token>.txt, since TikTok looks for the
# file directly under whichever prefix was registered.
TIKTOK_VERIFICATION=
