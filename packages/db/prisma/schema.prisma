generator client {
  provider = "prisma-client-js"
  output   = "../generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// Identity & access
// ============================================================

model User {
  id              String    @id @default(cuid())
  email           String    @unique
  passwordHash    String
  name            String
  avatarUrl       String?
  mfaEnabled      Boolean   @default(false)
  mfaSecret       String? // encrypted TOTP secret (AES-256-GCM)
  emailVerifiedAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  memberships      Membership[]
  refreshTokens    RefreshToken[]
  auditLogs        AuditLog[]
  contentItems     ContentItem[]
  sentInvitations  Invitation[]  @relation("SentInvitations")
  submittedContent ContentItem[] @relation("SubmittedContent")
  reviewedContent  ContentItem[] @relation("ReviewedContent")
}

// A workspace is either a company/team or a solo content creator's studio.
// The distinction drives UI language and how the AI frames its content.
enum OrgType {
  BUSINESS
  CREATOR
}

model Organization {
  id              String   @id @default(cuid())
  name            String
  slug            String   @unique
  type            OrgType  @default(BUSINESS)
  logoUrl         String?
  requireApproval Boolean  @default(false) // content must be APPROVED before scheduling/publishing
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  memberships        Membership[]
  invitations        Invitation[]
  businessProfile    BusinessProfile?
  connections        SocialConnection[]
  contentItems       ContentItem[]
  mediaAssets        MediaAsset[]
  campaigns          Campaign[]
  postingPlans       PostingPlan[]
  scheduledPosts     ScheduledPost[]
  agentRuns          AgentRun[]
  analyticsSnapshots AnalyticsSnapshot[]
  auditLogs          AuditLog[]
  apiKeys            ApiKey[]
  subscription       Subscription?
  usageRecords       UsageRecord[]
  brandKit           BrandKit?
  seoAudits          SeoAudit[]
  seoFixes           SeoFix[]
  productCatalogue   Product[]
  paymentApplications PaymentApplication[]
}

enum Role {
  OWNER
  ADMIN
  EDITOR
  VIEWER
}

model Membership {
  id        String   @id @default(cuid())
  userId    String
  orgId     String
  role      Role     @default(OWNER)
  /// Bumped whenever this person's access to this workspace changes: a role
  /// change, a password change, an MFA change, or "sign out everywhere".
  ///
  /// Finding S-10: authorization read the role out of the JWT and never
  /// consulted this row, so a demoted ADMIN kept ADMIN for the life of their
  /// access token, and a removed member kept full access long enough to delete
  /// every connection and export the catalogue.
  sessionVersion Int   @default(0)
  createdAt DateTime @default(now())

  user User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  org  Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([userId, orgId])
  @@index([orgId])
}

model Invitation {
  id          String    @id @default(cuid())
  orgId       String
  email       String
  role        Role      @default(EDITOR)
  tokenHash   String    @unique // sha256 of the raw invite token; raw token only in the invite link
  invitedById String?
  expiresAt   DateTime
  acceptedAt  DateTime?
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())

  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  invitedBy User?        @relation("SentInvitations", fields: [invitedById], references: [id], onDelete: SetNull)

  @@index([orgId])
  @@index([email])
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  /// The workspace this session was scoped to. Finding B-1: the row recorded
  /// only the user, so refresh() returned memberships[0] and silently moved a
  /// session back to the first workspace. For an agency managing several
  /// clients that means the next post goes to the wrong client's channels —
  /// guaranteed for any session open longer than the 15-minute access token.
  orgId     String?
  /// Every token rotated from one original login shares a family id. Finding
  /// S-15: a replayed token was rejected but the family was not revoked, so
  /// theft was invisible. Reuse of an already-rotated token now revokes the
  /// whole family and forces re-authentication (RFC 9700 §4.14.2).
  familyId  String?
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  userAgent String?
  ip        String?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  /// Retention (D-3) sweeps on these two columns.
  @@index([expiresAt])
  @@index([revokedAt])
}

model ApiKey {
  id         String    @id @default(cuid())
  orgId      String
  name       String
  keyHash    String    @unique
  lastUsedAt DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId])
}

// ============================================================
// Platform connections
// ============================================================

enum Platform {
  FACEBOOK
  INSTAGRAM
  THREADS
  TIKTOK
  LINKEDIN
  PINTEREST
  SNAPCHAT
  YOUTUBE
  X
  TELEGRAM
  WHATSAPP_BUSINESS
  REDDIT
  DISCORD
  MEDIUM
  TUMBLR
  WORDPRESS
  SHOPIFY
  WOOCOMMERCE
  GOOGLE_BUSINESS
  GOOGLE_ANALYTICS
  GOOGLE_SEARCH_CONSOLE
  GOOGLE_ADS
  META_ADS
  TIKTOK_ADS
  MICROSOFT_ADS
  MAILCHIMP
  BREVO
  HUBSPOT
  ZAPIER
  SLACK
  NOTION
  GITHUB
  CLOUDFLARE
}

enum ConnectionStatus {
  ACTIVE
  /// Inside the refresh window and not yet renewed. Finding B-7: expiresAt was
  /// written in four places and read in none, so a TikTok connection stopped
  /// working a day after it was made while still displaying ACTIVE.
  EXPIRING_SOON
  /// The token has lapsed and a refresh failed or was never possible. The
  /// scheduler skips these rather than attempting a publish that cannot work.
  EXPIRED
  /// The platform told us the grant is gone — the person revoked it, or removed
  /// the app. Distinct from EXPIRED because reconnecting is the only remedy.
  REVOKED
  ERROR
  DISCONNECTED
}

model SocialConnection {
  id                   String           @id @default(cuid())
  orgId                String
  platform             Platform
  status               ConnectionStatus @default(ACTIVE)
  displayName          String
  externalId           String? // page id / channel id / username on the platform
  // AES-256-GCM encrypted JSON blob of tokens/credentials, never stored in plaintext
  encryptedCredentials String           @db.Text
  scopes               String[]         @default([])
  metadata             Json?
  expiresAt            DateTime?
  lastCheckedAt        DateTime?
  lastErrorAt          DateTime?
  lastError            String?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  org            Organization    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  scheduledPosts ScheduledPost[]
  snapshots      AnalyticsSnapshot[]

  @@index([orgId, platform])
}

// ============================================================
// Business profile
// ============================================================

model BusinessProfile {
  id             String   @id @default(cuid())
  orgId          String   @unique
  businessName   String
  industry       String
  description    String   @db.Text
  targetAudience String   @db.Text
  location       String?
  website        String?
  products       String[] @default([])
  services       String[] @default([])
  goals          String[] @default([])
  brandVoice     String?
  competitors    String[] @default([])
  seasonalNotes  String?
  // Reading a catalogue off a website is something the owner opts into, not a
  // default. Recorded as who and when rather than a flag, so it can be shown
  // back and answered for.
  productImportConsentAt DateTime?
  productImportConsentBy String?
  lastProductImportAt    DateTime?
  /// Re-read the shop on a schedule, so a new product does not wait for
  /// someone to remember to press import.
  productAutoImport      Boolean    @default(false)
  /// Post what the import finds. Separate from importing on purpose: reading
  /// your own catalogue and publishing from it are different decisions, and
  /// one is far easier to undo than the other.
  productAutoPost        Boolean    @default(false)
  /// Where those posts go. Empty means nowhere, which is why auto-post cannot
  /// be switched on without choosing.
  productPostPlatforms   Platform[] @default([])
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
}

/// One product as its own shop describes it. Imported, never invented: the
/// price and description here go onto a customer's feed.
model Product {
  id           String    @id @default(cuid())
  orgId        String
  /// The product's own page. Natural key with orgId, a shop does not sell the
  /// same thing at two URLs, and re-importing must update rather than duplicate.
  sourceUrl    String
  title        String
  description  String?   @db.Text
  price        Decimal?  @db.Decimal(14, 2)
  /// The shop's own recorded former price. Whether it may be stated in a post
  /// depends on where the shop sells, so it is kept as evidence rather than
  /// as something to publish.
  compareAtPrice Decimal? @db.Decimal(14, 2)
  currency     String?
  imageUrl     String?
  availability String?
  sku          String?
  /// Which route read it: shopify | jsonld | microdata | opengraph | storefront_api
  source       String
  /// Sizes, colours and category as the shop records them: { "sizes": [...],
  /// "colours": [...], "category": "..." }. What lets a post answer "will it
  /// fit me" without the reader opening the link.
  variants     Json?
  /// Fingerprint of the fields that matter, so a re-import can tell a genuine
  /// change from a shop that simply republished the same page.
  contentHash  String
  firstSeenAt  DateTime  @default(now())
  lastSeenAt   DateTime  @default(now())
  /// Kept so the same product is not posted twice in a row while others wait.
  lastPostedAt DateTime?
  postCount    Int       @default(0)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, sourceUrl])
  @@index([orgId, lastPostedAt])
}

// ============================================================
// Content
// ============================================================

enum ContentType {
  SOCIAL_POST
  BLOG_POST
  EMAIL
  AD_COPY
  CAPTION
  SCRIPT
  PRODUCT_DESCRIPTION
  PRESS_RELEASE
  NEWSLETTER
  LANDING_PAGE
  OTHER
}

enum ContentStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  SCHEDULED
  PUBLISHED
  FAILED
  ARCHIVED
}

model ContentItem {
  id          String        @id @default(cuid())
  orgId       String
  campaignId  String?
  createdById String?
  type        ContentType   @default(SOCIAL_POST)
  status      ContentStatus @default(DRAFT)
  title       String?
  body        String        @db.Text
  hashtags    String[]      @default([])
  // Per-platform variants: { "TELEGRAM": { "body": "...", "hashtags": [...] }, ... }
  variants    Json?
  // A/B test variants: { "A": { "body": "...", "hashtags": [...] }, "B": { ... } }
  abVariants  Json?
  evergreen   Boolean       @default(false)
  lastRecycledAt DateTime?
  // How long this post runs once photos are rendered to video, and whether
  // they are. Per post rather than per workspace: length is a creative choice
  // that changes with the content, not a setting you fix once.
  slideshowSeconds Int      @default(30)
  // TikTok ignores this, its API takes no still post that can carry audio.
  // Everywhere else a still carousel is a legitimate format worth keeping.
  renderAsVideo    Boolean  @default(true)
  aiGenerated Boolean       @default(false)
  agentRunId  String?
  // Approval workflow (Phase 6)
  submittedAt   DateTime?
  submittedById String?
  reviewedAt    DateTime?
  reviewedById  String?
  reviewNote    String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  org            Organization    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  campaign       Campaign?       @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  createdBy      User?           @relation(fields: [createdById], references: [id], onDelete: SetNull)
  submittedBy    User?           @relation("SubmittedContent", fields: [submittedById], references: [id], onDelete: SetNull)
  reviewedBy     User?           @relation("ReviewedContent", fields: [reviewedById], references: [id], onDelete: SetNull)
  mediaAssets    MediaAsset[]
  scheduledPosts ScheduledPost[]

  @@index([orgId, status])
  @@index([orgId, createdAt])
}

enum MediaKind {
  IMAGE
  VIDEO
  AUDIO
  DOCUMENT
}

enum MediaSource {
  UPLOADED
  AI_GENERATED
  IMPORTED
}

model MediaAsset {
  id            String      @id @default(cuid())
  orgId         String
  contentItemId String?
  kind          MediaKind
  source        MediaSource @default(UPLOADED)
  storageKey    String // key in MinIO/S3
  url           String?
  mimeType      String
  sizeBytes     Int?
  width         Int?
  height        Int?
  durationSec   Float?
  prompt        String?  @db.Text // generation prompt for AI assets
  preset        String? // platform size preset used (e.g. INSTAGRAM_FEED)
  agentRunId    String?
  metadata      Json?
  createdAt     DateTime    @default(now())

  org         Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  contentItem ContentItem? @relation(fields: [contentItemId], references: [id], onDelete: SetNull)

  @@index([orgId])
  @@index([contentItemId])
}

model BrandKit {
  id               String   @id @default(cuid())
  orgId            String   @unique
  primaryColor     String   @default("#6366F1")
  secondaryColor   String   @default("#0EA5E9")
  logoStorageKey   String? // MinIO/S3 key of the uploaded logo (PNG)
  logoUrl          String?
  fontFamily       String?
  watermarkEnabled Boolean  @default(false)
  // Background track mixed under generated video. TikTok's own catalogue is
  // only usable inside their app, so anything published directly has to carry
  // audio the workspace is licensed to use.
  musicStorageKey  String?
  musicUrl         String?
  musicName        String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
}

enum CampaignStatus {
  DRAFT
  ACTIVE
  PAUSED
  COMPLETED
}

model Campaign {
  id        String         @id @default(cuid())
  orgId     String
  name      String
  objective String?
  status    CampaignStatus @default(DRAFT)
  startDate DateTime?
  endDate   DateTime?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  org          Organization  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  contentItems ContentItem[]

  @@index([orgId])
}

// ============================================================
// Scheduling
// ============================================================

enum CadenceType {
  DAILY_1
  DAILY_2
  DAILY_3
  HOURLY
  WEEKENDS
  CUSTOM
}

model PostingPlan {
  id             String      @id @default(cuid())
  orgId          String
  name           String
  cadence        CadenceType @default(DAILY_1)
  customCron     String?
  timezone       String      @default("UTC")
  platforms      Platform[]  @default([])
  preferredTimes String[]    @default([]) // "09:00", "17:30"; empty = best-time detection
  active         Boolean     @default(true)
  // Autopilot: the planner auto-generates and schedules content for this plan
  autoGenerate     Boolean   @default(false)
  topics           String[]  @default([]) // content angles the planner rotates through
  abTesting        Boolean   @default(false)
  recycleEvergreen Boolean   @default(false)
  generateImages   Boolean   @default(false) // autopilot also generates an image per post
  // Inherited by every post this plan generates.
  slideshowSeconds Int       @default(30)
  renderAsVideo    Boolean   @default(true)
  lastPlannedAt    DateTime? // planner high-water mark (avoid double planning)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId])
}

enum ScheduleStatus {
  PENDING
  PROCESSING
  PUBLISHED
  FAILED
  CANCELLED
}

model ScheduledPost {
  id              String         @id @default(cuid())
  orgId           String
  contentItemId   String
  connectionId    String
  scheduledAt     DateTime
  timezone        String         @default("UTC")
  status          ScheduleStatus @default(PENDING)
  variantKey      String? // "A" | "B" when the content item is A/B tested
  planId          String? // set when created by the autopilot planner
  attempts        Int            @default(0)
  lockedAt        DateTime? // worker lock to prevent double publishing
  publishedAt     DateTime?
  externalPostId  String?
  externalPostUrl String?
  error           String?        @db.Text
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  org         Organization     @relation(fields: [orgId], references: [id], onDelete: Cascade)
  contentItem ContentItem      @relation(fields: [contentItemId], references: [id], onDelete: Cascade)
  connection  SocialConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@index([status, scheduledAt])
  @@index([orgId, scheduledAt])
}

// ============================================================
// AI agent runs
// ============================================================

enum AgentType {
  CONTENT
  SEO
  IMAGE
  VIDEO
  MARKETING
  ANALYTICS
  GROWTH
  TREND
  COMPETITOR
  COMMUNITY
}

enum RunStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
}

model AgentRun {
  id           String    @id @default(cuid())
  orgId        String
  agent        AgentType
  status       RunStatus @default(QUEUED)
  taskId       String? // Celery task id
  input        Json
  output       Json?
  provider     String? // anthropic | openai
  model        String?
  inputTokens  Int?
  outputTokens Int?
  costUsd      Decimal?  @db.Decimal(10, 6)
  durationMs   Int?
  error        String?   @db.Text
  createdAt    DateTime  @default(now())
  completedAt  DateTime?

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId, agent, createdAt])
  @@index([taskId])
}

// ============================================================
// SEO
// ============================================================

model SeoAudit {
  id           String   @id @default(cuid())
  orgId        String
  agentRunId   String?
  url          String
  status       RunStatus @default(QUEUED)
  score        Int? // 0-100
  pagesCrawled Int      @default(0)
  // [{severity, code, page, message, recommendation}]
  findings        Json?
  // {clusters: [{topic, intent, keywords: []}]}
  keywords        Json?
  // [{page, currentTitle, suggestedTitle, currentDescription, suggestedDescription}]
  metaSuggestions Json?
  // JSON-LD for the business (Organization/LocalBusiness)
  schemaMarkup    Json?
  sitemapXml      String? @db.Text
  robotsTxt       String? @db.Text
  // Detected site stack, "wordpress" | "shopify" | "wix" | "nextjs" | "html"…
  // Drives which set of apply-instructions each fix carries.
  platform        String?
  error           String? @db.Text
  createdAt       DateTime @default(now())
  completedAt     DateTime?

  org   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  fixes SeoFix[]

  @@index([orgId, createdAt])
}

/// How a fix reaches the live site. FIX_PACK is the universal fallback, we hand
/// the user the exact patch and they paste it. The others write for them and are
/// added one at a time; the SeoFix contract is identical for all of them.
enum FixChannel {
  FIX_PACK
  CLOUDFLARE
  WORDPRESS
  SHOPIFY
  GITHUB
}

/// PROPOSED → APPLIED → VERIFIED is the happy path. APPLIED means "written to the
/// site" (by us, or by the user telling us they did it); only a re-crawl that no
/// longer reports the finding earns VERIFIED. A fix nobody re-checked is a claim.
enum FixStatus {
  PROPOSED
  APPLIED
  VERIFIED
  FAILED
  DISMISSED
}

/// What shape the change is, which decides where the user (or a write channel)
/// puts it.
enum FixKind {
  HEAD_TAG // snippet for <head>: title, description, canonical, OG, JSON-LD
  FILE // whole file at the site root: robots.txt, sitemap.xml, IndexNow key
  ATTRIBUTE // attribute on existing markup, e.g. img alt text
  MANUAL // needs a human decision or infra change, we can't hand over a patch
}

/// One actionable change derived from an audit finding.
///
/// Deliberately shaped like ScheduledPost: it is a unit of work with a status,
/// an attempt count and an error, so the same propose → apply → verify loop and
/// the same UI patterns carry over.
model SeoFix {
  id          String     @id @default(cuid())
  orgId       String
  auditId     String
  findingCode String // the audit rule this resolves, e.g. "missing_description"
  kind        FixKind
  channel     FixChannel @default(FIX_PACK)
  status      FixStatus  @default(PROPOSED)
  severity    String // critical | warning | info, mirrors the finding
  targetUrl   String // page (or site root, for FILE fixes) the change applies to
  title       String // short human label, e.g. "Add a meta description"
  // What is on the page today; null when nothing is there yet. Kept so an
  // automated channel can revert exactly what it wrote.
  before      String?    @db.Text
  // The literal replacement, the tag, the attribute value, the file body.
  // Null for MANUAL fixes, which carry guidance only.
  after       String?    @db.Text
  filePath    String? // FILE fixes: "robots.txt", "sitemap.xml"
  guidance    String     @db.Text // where to put it, written for the detected stack
  attempts    Int        @default(0)
  appliedAt   DateTime?
  verifiedAt  DateTime?
  error       String?    @db.Text
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  org   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  audit SeoAudit     @relation(fields: [auditId], references: [id], onDelete: Cascade)

  @@index([orgId, status])
  @@index([auditId])
}

// ============================================================
// Analytics
// ============================================================

model AnalyticsSnapshot {
  id           String   @id @default(cuid())
  orgId        String
  connectionId String?
  metric       String // followers | engagement | reach | impressions | clicks | ...
  value        Float
  dimensions   Json?
  capturedAt   DateTime @default(now())

  org        Organization      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  connection SocialConnection? @relation(fields: [connectionId], references: [id], onDelete: SetNull)

  @@index([orgId, metric, capturedAt])
}

// ============================================================
// Ops
// ============================================================

model AuditLog {
  id         String   @id @default(cuid())
  orgId      String?
  userId     String?
  action     String // auth.login | connection.created | post.published | ...
  targetType String?
  targetId   String?
  ip         String?
  userAgent  String?
  metadata   Json?
  createdAt  DateTime @default(now())

  org  Organization? @relation(fields: [orgId], references: [id], onDelete: SetNull)
  user User?         @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([orgId, createdAt])
  // D-1. The payment dedup query filtered on (action, targetId), neither of
  // which was indexed, on the highest-write table in the schema — so the query
  // deciding whether to credit a customer degraded linearly with the age of the
  // database. The dedup itself has moved to PaymentApplication below, but
  // "show me everything that happened to this object" is an ordinary support
  // question and deserves an index either way.
  @@index([action, targetId])
}

/// One row per payment this system has acted on. Finding S-8.
///
/// The idempotency marker was an AuditLog row, checked with a read-then-write,
/// with no constraint behind it. Two paths race BY DESIGN — Paystack's webhook
/// and the browser's POST /billing/verify — and between the subscription upsert
/// and the marker insert there was a window in which the second caller found no
/// marker but read the already-extended currentPeriodEnd, and granted a second
/// 31-day month for one payment. The marker write also carried
/// `.catch(() => undefined)`, so a transient database error silently removed
/// the correctness mechanism and Paystack's retry credited again.
///
/// This is a separate table rather than `@@unique([action, targetId])` on
/// AuditLog, which is what the remediation directive specified. That constraint
/// would have been wrong here: `connection.updated`, `content.updated` and
/// `account.profile_updated` all legitimately repeat against the same targetId,
/// so a workspace reconnecting a channel or a user saving their name twice
/// would start throwing P2002 on an ordinary action. An audit log records what
/// happened; it should not also be the thing that decides whether it may.
model PaymentApplication {
  id        String    @id @default(cuid())
  orgId     String
  provider  String    @default("paystack")
  /// The provider's transaction reference. Unique per provider, which is what
  /// makes a second credit impossible rather than unlikely.
  reference String
  /// The provider's own event id, when it sends one. A retried webhook carries
  /// the same value, so this catches a replay that changed the reference.
  eventId   String?
  planCode  String
  mode      String
  paidUntil DateTime?
  createdAt DateTime  @default(now())

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([provider, reference])
  @@unique([provider, eventId])
  @@index([orgId, createdAt])
}

model WebhookEvent {
  id             String    @id @default(cuid())
  platform       Platform
  externalId     String?
  payload        Json
  signatureValid Boolean   @default(false)
  processedAt    DateTime?
  createdAt      DateTime  @default(now())

  @@index([platform, createdAt])
}

// ============================================================
// Billing, a 24 hour trial, then Paystack
// ============================================================

model Plan {
  id              String   @id @default(cuid())
  code            String   @unique // FREE | PRO | SCALE
  name            String
  priceMonthlyUsd Decimal  @db.Decimal(10, 2)
  limits          Json // { postsPerMonth, aiTokensPerMonth, connections, seats }
  createdAt       DateTime @default(now())

  subscriptions Subscription[]
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
}

/// A workspace's billing state. Every workspace has one from the moment it is
/// created: TRIALING with `currentPeriodEnd` 24 hours out, which is what the
/// read-only guard reads. Payment is Paystack's, and only Paystack's.
model Subscription {
  id     String             @id @default(cuid())
  orgId  String             @unique
  planId String
  status SubscriptionStatus @default(TRIALING)

  /// Paystack customer code (CUS_...) and subscription code (SUB_...).
  /// The columns keep the names they were created with. Renaming a live column
  /// buys nothing a field name does not, and would break the running API for
  /// the minutes between the migration and the deploy, during which a
  /// successful payment would fail to activate a plan.
  providerCustomerId     String?   @map("stripeCustomerId")
  providerSubscriptionId String?   @map("stripeSubscriptionId")
  /// When the trial runs out, or when the paid period next renews.
  currentPeriodEnd       DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  org  Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  plan Plan         @relation(fields: [planId], references: [id])
}

model UsageRecord {
  id          String   @id @default(cuid())
  orgId       String
  metric      String // ai_tokens | posts_published | images_generated | videos_generated
  quantity    Float
  periodStart DateTime
  createdAt   DateTime @default(now())

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId, metric, periodStart])
}
