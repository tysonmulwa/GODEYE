{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "godeye-web",
  "main": ".open-next/worker.js",
  // nodejs_compat is required by the OpenNext adapter; the compatibility date
  // must be 2024-09-23 or later for it to take effect.
  "compatibility_date": "2025-03-25",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  }
}
